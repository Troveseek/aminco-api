# AMENCO Club Backend
# Environment variables (copy to .env and fill in real values before running)

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Database (Supabase direct connection string) ─────────────
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin seed credentials ───────────────────────────────────
ADMIN_EMAIL=admin@amenco-club.dz
ADMIN_PASSWORD=AmencoAdmin2026!

# ── App config ──────────────────────────────────────────────
APP_BASE_URL=https://your-deployed-backend-url.railway.app
SUBSCRIPTION_PRICE_DZD=1000
SUBSCRIPTION_DURATION_YEARS=1

# ── Image upload storage ─────────────────────────────────────
# Options: "supabase" (uses Supabase Storage) or "local" (saves to uploads/ dir)
STORAGE_BACKEND=supabase
SUPABASE_STORAGE_BUCKET=amenco-uploads
MAX_IMAGE_SIZE_KB=300
